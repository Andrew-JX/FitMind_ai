NODE_ENV=development
PORT=3000
VITE_API_BASE_URL=
# Footer filing numbers, read at client build time. Leave blank on deployments
# without an ICP filing (e.g. the overseas demo); the footer then shows only the
# agreement and privacy links. Format: 沪ICP备2026000001号 / 沪公网安备 31010502001234号
VITE_ICP_BEIAN_NUMBER=
VITE_PUBLIC_SECURITY_BEIAN_NUMBER=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitmind_ai
JWT_SECRET=replace-with-a-long-random-string
# Self-service registration gate (docs/china-launch-plan.md §3.2a). FAIL-SAFE CLOSED:
# unset, blank, or a typo all keep POST /api/auth/register invite-only (403).
# Only an explicit off/false/0/no opens public sign-up.
# Local dev and the auth smoke scripts need this set to off.
REGISTRATION_INVITE_ONLY=off
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Free Google Gemini key for the intake parser (https://aistudio.google.com/apikey).
GEMINI_API_KEY=optional-free-gemini-key-for-intake-llm
# Optional Gemini model override (default gemini-2.0-flash). Try gemini-1.5-flash if you hit quota.
GEMINI_MODEL=gemini-2.0-flash
# Free Groq key for all LLM features (intake parser + assistant routing/phrasing); no region limits.
# https://console.groq.com/keys
GROQ_API_KEY=optional-groq-key-for-llm-features
# Optional Groq model override (default llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.3-70b-versatile
# Shared ENV-level OpenAI-compatible BYO endpoint for assistant + intake parser.
# Examples:
#   DeepSeek: https://api.deepseek.com
#   Qwen/DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi/Moonshot: https://api.moonshot.cn/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
# Workout voice/text intake parser. mock (default) and off use the rule parser.
# groq, openai_compatible, gemini (free), or anthropic (paid) parse free-form speech with multiple exercises.
WORKOUT_INTAKE_LLM_PROVIDER=mock
# Chat assistant provider. mock (default) for stable demos; groq/openai_compatible for OpenAI-compatible tool calling.
ASSISTANT_PROVIDER=mock
# Opt-in LLM re-phrasing of the answer summary (Slice 11.3b). Default off.
# Only active when also ASSISTANT_PROVIDER=groq or openai_compatible; runtime faithfulness gates the rewrite.
ASSISTANT_PHRASING=off
# Medical safety gate for acute pain/symptom boundaries (Slice 10). Default on.
# Only explicit disable tokens off/false/0/no turn it off; unset/blank/typo stays on.
ASSISTANT_SAFETY_GATE=on
# Slice 8 Tier 1 weekly report digest generation. Default off; enable only for dogfood.
WEEKLY_REPORT_DELIVERY_ENABLED=off
# Shared by Vercel API and Cloudflare Worker scheduled trigger; never expose client-side.
WEEKLY_REPORT_CRON_SECRET=replace-with-a-long-random-string
VOYAGE_API_KEY=optional-for-pgvector-rag-embeddings
# Opt-in Voyage reranking for RAG retrieval. Default off; eval uses deterministic fixture reranking.
RAG_RERANKING_ENABLED=off
