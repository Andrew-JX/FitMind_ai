NODE_ENV=development
PORT=3000
VITE_API_BASE_URL=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitmind_ai
JWT_SECRET=replace-with-a-long-random-string
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Free Google Gemini key for the intake parser (https://aistudio.google.com/apikey).
GEMINI_API_KEY=optional-free-gemini-key-for-intake-llm
# Optional Gemini model override (default gemini-2.0-flash). Try gemini-1.5-flash if you hit quota.
GEMINI_MODEL=gemini-2.0-flash
# Free Groq key for all LLM features (intake parser + assistant routing/phrasing); no region limits.
# https://console.groq.com/keys
GROQ_API_KEY=optional-groq-key-for-llm-features
# Optional Groq model override (default llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.3-70b-versatile
# Workout voice/text intake parser. mock (default) and off use the rule parser.
# groq or gemini (free) or anthropic (paid) parse free-form speech with multiple exercises.
WORKOUT_INTAKE_LLM_PROVIDER=mock
# Chat assistant provider. mock (default) for stable demos; anthropic for the real LLM.
ASSISTANT_PROVIDER=mock
# Opt-in LLM re-phrasing of the answer summary (Slice 11.3b). Default off.
# Only active when also ASSISTANT_PROVIDER=groq; runtime faithfulness gates the rewrite.
ASSISTANT_PHRASING=off
VOYAGE_API_KEY=optional-for-pgvector-rag-embeddings
