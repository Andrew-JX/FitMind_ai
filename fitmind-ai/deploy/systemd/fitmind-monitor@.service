[Unit]
Description=FitMind production monitor (%i)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/fitmind-monitor.env
Environment=FITMIND_MONITOR_STATE_DIR=%h/.local/state/fitmind-monitor
ExecCondition=/usr/bin/bash -c 'case "$1" in /*) test -x "$1/deploy/scripts/fitmind-monitor.sh" ;; *) exit 1 ;; esac' monitor-path ${FITMIND_REPOSITORY_DIR}
ExecStart=/usr/bin/bash ${FITMIND_REPOSITORY_DIR}/deploy/scripts/fitmind-monitor.sh %i
NoNewPrivileges=true
PrivateTmp=true
