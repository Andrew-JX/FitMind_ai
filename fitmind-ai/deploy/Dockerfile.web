FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY client/package.json client/package.json
COPY shared/package.json shared/package.json
COPY server/package.json server/package.json

RUN pnpm install --frozen-lockfile --filter @fitmind/client...

COPY client client
COPY shared shared

ARG VITE_API_BASE_URL=
ARG VITE_ICP_BEIAN_NUMBER=苏ICP备2026054660号
ARG VITE_PUBLIC_SECURITY_BEIAN_NUMBER=

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ICP_BEIAN_NUMBER=$VITE_ICP_BEIAN_NUMBER
ENV VITE_PUBLIC_SECURITY_BEIAN_NUMBER=$VITE_PUBLIC_SECURITY_BEIAN_NUMBER

RUN pnpm --filter @fitmind/client build

FROM nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236 AS runtime

COPY deploy/nginx/client.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/dist /usr/share/nginx/html

EXPOSE 80
