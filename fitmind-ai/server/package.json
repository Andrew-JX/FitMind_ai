{
  "name": "@fitmind/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:migrate": "node-pg-migrate --config-file ./pgmigrate.config.cjs up",
    "db:migrate:down": "node-pg-migrate --config-file ./pgmigrate.config.cjs down",
    "dev": "tsx watch src/server.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src pgmigrate.config.cjs",
    "test": "vitest run src/**/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "node-pg-migrate": "^8.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
