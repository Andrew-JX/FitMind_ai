# Production template for https://fitmind.jimmyuuu.com. The application server
# is planned for Tencent Cloud in mainland China, while PostgreSQL remains on
# Neon overseas. Copy the server values to .env on the server and inject the
# VITE_* values when building the client. See docs/china-launch-plan.md.

NODE_ENV=production
PORT=3000
# Runtime URL: use Neon's pooled connection string (`-pooler` hostname).
DATABASE_URL=
# Migration URL: use Neon's direct, non-pooler connection string.
MIGRATION_DATABASE_URL=
# Deployment guardrails: exact hostnames from the two URLs above, without
# protocol, port, path, or credentials. deploy.sh checks these before migration.
EXPECTED_DATABASE_HOST=
EXPECTED_MIGRATION_DATABASE_HOST=
EXPECTED_DATABASE_NAME=neondb
JWT_SECRET=

# --- Registration -----------------------------------------------------------
# Leave UNSET on this host. The flag is fail-safe: only an explicit off/false/0/no
# opens registration, so unset means invite-only. Accounts: pnpm create:user
# REGISTRATION_INVITE_ONLY=

# --- Model provider (DeepSeek, in-country) ----------------------------------
# Both switches must be set. Changing only ASSISTANT_PROVIDER leaves voice/text
# workout intake on the rule parser: no error, no warning, just worse parsing.
ASSISTANT_PROVIDER=openai_compatible
WORKOUT_INTAKE_LLM_PROVIDER=openai_compatible
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_MODEL=deepseek-chat
OPENAI_COMPAT_API_KEY=

# --- Data residency ----------------------------------------------------------
# The application server is in mainland China, but the Neon database is not.
# Keep this `overseas` while Neon stores user data outside mainland China so the
# registration flow requires the separate cross-border consent.
DATA_RESIDENCY=overseas

# --- Overseas providers: MUST stay empty ------------------------------------
# Filling one of these would send request content abroad, and the privacy policy
# served from this host states that it does not. They are also unreachable from
# a mainland network, so setting one buys nothing and breaks the claim. Code
# keeps supporting them for the overseas demo deployment.
#
# Do NOT read this as "empty keys mean no personal information leaves the
# country". Two paths do not pass through these keys at all: the browser's
# built-in speech recognition (audio may go to the browser vendor's cloud, which
# this service cannot control) and the hosting and database location itself.
# All three layers have to be in-country for the claim to hold. See
# docs/china-launch-plan.md §3.2d.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=

# RAG degrades to keyword retrieval without VOYAGE_API_KEY. That is the accepted
# trade for now; a domestic embedding provider is its own batch.
RAG_RERANKING_ENABLED=off

# --- Scheduled work ---------------------------------------------------------
# Weekly digests compute their week boundaries in UTC, which is 8 hours off for
# users here — Sunday evening sessions land in the wrong week. Keep off until
# that is fixed.
WEEKLY_REPORT_DELIVERY_ENABLED=off
WEEKLY_REPORT_CRON_SECRET=

# --- Assistant behaviour ----------------------------------------------------
ASSISTANT_SAFETY_GATE=on
ASSISTANT_PHRASING=off
ASSISTANT_PLAN_ADHERENCE_CONTEXT=off

# --- Client build-time values ------------------------------------------------
# Read when the client is built, not when the server starts: changing these
# requires a rebuild, not a restart.
VITE_API_BASE_URL=
# Issued ICP filing for fitmind.jimmyuuu.com. This is public information and is
# rendered as a link to the MIIT filing query.
VITE_ICP_BEIAN_NUMBER=苏ICP备2026054660号
# Public-security filing is due within 30 days of going live.
VITE_PUBLIC_SECURITY_BEIAN_NUMBER=
