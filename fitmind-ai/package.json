{
  "name": "fitmind-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "type-check": "pnpm --recursive --if-present run type-check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "node -e \"console.log('No root integration test suite is configured. Use the DB-backed smoke commands instead.')\"",
    "smoke:auth": "pnpm --filter @fitmind/server run smoke:auth",
    "smoke:assistant": "pnpm --filter @fitmind/server run smoke:assistant",
    "smoke:assistant-insights": "pnpm --filter @fitmind/server run smoke:assistant-insights",
    "smoke:muscle-load": "pnpm --filter @fitmind/server run smoke:muscle-load",
    "smoke:training": "pnpm --filter @fitmind/server run smoke:training",
    "smoke:workout-intake": "pnpm --filter @fitmind/server run smoke:workout-intake",
    "seed:assistant-demo": "pnpm --filter @fitmind/server run seed:assistant-demo",
    "verify": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test:unit",
    "db:migrate": "pnpm --filter @fitmind/server run db:migrate",
    "dev:client": "pnpm --filter @fitmind/client dev",
    "dev:server": "pnpm --filter @fitmind/server dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
